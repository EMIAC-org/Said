# AirNote — local development environment
#
# Copy this to `.env` at the repo root. The real `.env` is gitignored.
# Production installs do NOT use this file — end-users save their keys
# via `vp deepgram-key` and `vp auth` (Keychain + local SQLite).
#
# Most variables are optional with sensible fallbacks. The minimum to run
# the desktop app end-to-end against the cloud gateway is just one:
#   GATEWAY_API_KEY
# Self-hosted backend or direct-provider routing needs more.

# ── Cloud gateway (default routing) ──────────────────────────────────────────

# Required for cloud-gateway routing. Issued by the EMIAC ops team.
GATEWAY_API_KEY=

# Override the gateway base URL. Defaults to https://gateway.outreachdeal.com.
# Useful when running a local copy of the gateway.
# CLOUD_API_URL=http://localhost:8787

# ── Speech-to-text ─────────────────────────────────────────────────────────────

# ── Direct STT keys ────────────────────────────────────────────────────────────

# Deepgram — required for STT. Also storable in Settings.
# Get a key at https://console.deepgram.com/.
DEEPGRAM_API_KEY=

# By default AirNote avoids Bluetooth headset microphones when another mic is
# available, because opening the headset mic forces macOS into low-quality call
# audio for the Bluetooth output. Set true only if you explicitly want that mic.
# AIRNOTE_ALLOW_BLUETOOTH_MIC=false

# Dictation temporarily mutes local speaker output to reduce echo. The app skips
# this automatically for Bluetooth output devices; set true to disable entirely.
# AIRNOTE_DISABLE_SPEAKER_SUPPRESSION=false

# Soniox — optional; for tools/stt-compare/transcribe_soniox.py benchmarks.
# Get a key at https://console.soniox.com/.
SONIOX_API_KEY=

# ── Direct LLM providers (optional fallbacks) ────────────────────────────────

# Groq LPU — fastest TTFT, free tier. Used when llm_provider=groq in prefs.
# Get a key at https://console.groq.com/keys.
GROQ_API_KEY=

# Beta polish providers (Settings → About → Beta mode). Optional — store in Settings API Keys.
# Server runtime uses deploy/control-plane/.env instead (DEEPINFRA_API_KEY, CEREBRAS_API_KEY).
# CEREBRAS_API_KEY=
# DEEPINFRA_API_KEY=

# Smart-tier dictation polish model (selected_model=smart). Defaults to GPT OSS 120B on Groq.
# AIRNOTE_SMART_POLISH_MODEL=openai/gpt-oss-120b

# Google Gemini Direct. Used when llm_provider=gemini_direct.
# Get a key at https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=

# OpenAI direct (only used as a last-resort fallback when every other
# provider fails — most setups go through ChatGPT OAuth instead).
OPENAI_API_KEY=
# Control-plane message-polish audio transcription, matching the n8n OpenAI
# audio transcribe node default.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# DeepSeek direct. Used by meeting transcript cleanup when
# AIRNOTE_MEETING_CLEANUP_PROVIDER=deepseek, and message-polish mode audio.
DEEPSEEK_API_KEY=
DEEPSEEK_MESSAGE_POLISH_MODEL=deepseek-v4-flash

# ── Meeting local transcription (whisper.cpp) ────────────────────────────────

# Optional local whisper.cpp binary/model overrides. If unset, the app tries
# `whisper-cli` on PATH and models under the app data directory. Meeting mode
# prefers the optimized meeting model order:
# ggml-large-v3-turbo.bin, ggml-large-v3.bin, ggml-large-v2.bin, medium,
# small, base, then tiny. Use the override only when you need a specific file.
# AIRNOTE_WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
# AIRNOTE_WHISPER_CPP_MODEL_DIR=~/Library/Application Support/VoicePolish/models
# AIRNOTE_WHISPER_CPP_MODEL=~/Library/Application Support/VoicePolish/models/ggml-large-v3-turbo.bin
# 0 prevents long-meeting context loops; -1 restores whisper.cpp default.
# AIRNOTE_MEETING_WHISPER_MAX_CONTEXT_TOKENS=0

# Meeting ASR quality gates. Defaults prefer no transcript over hallucinated
# transcript, because bad live chunks poison live chat, final summaries,
# action items, and decisions. Disable only while benchmarking recall.
# AIRNOTE_MEETING_WHISPER_SUPPRESS_NON_SPEECH=true
# AIRNOTE_MEETING_WHISPER_NO_FALLBACK=true
# AIRNOTE_MEETING_WHISPER_NO_SPEECH_GATE=true
# AIRNOTE_MEETING_WHISPER_NO_SPEECH_THRESHOLD=0.75
# AIRNOTE_MEETING_WHISPER_LOGPROB_GATE=true
# AIRNOTE_MEETING_WHISPER_LOGPROB_THRESHOLD=-0.35
# AIRNOTE_MEETING_WHISPER_ENTROPY_GATE=true
# AIRNOTE_MEETING_WHISPER_ENTROPY_THRESHOLD=2.0
# AIRNOTE_MEETING_WHISPER_CONFIDENCE_GATE=true
# AIRNOTE_MEETING_WHISPER_MIN_SEGMENT_CONFIDENCE=0.75

# Mic track defaults to English/Roman decoding because the meeting pipeline is
# optimized for spoken English/Hinglish notes.
# AIRNOTE_MEETING_MIC_WHISPER_LANGUAGE=en
# AIRNOTE_MEETING_MIC_WHISPER_TRANSLATE=false

# System track defaults to auto-language transcription, not translation. Meeting
# notes should preserve names and original wording; translation can warp names.
# AIRNOTE_MEETING_SYSTEM_WHISPER_LANGUAGE=auto
# AIRNOTE_MEETING_SYSTEM_WHISPER_TRANSLATE=false

# Live Meeting AI Chat uses a separate rolling whisper.cpp lane while the
# meeting is still recording. Final transcript generation above remains the
# source of truth after leaving the meeting.
# AIRNOTE_MEETING_LIVE_TRANSCRIPT_ENABLED=true
# AIRNOTE_MEETING_LIVE_TRANSCRIPT_CHUNK_SECS=8
# AIRNOTE_MEETING_LIVE_TRANSCRIPT_MIN_SECS=2
# AIRNOTE_MEETING_LIVE_TRANSCRIPT_POLL_MS=1000
# AIRNOTE_MEETING_LIVE_TRANSCRIPT_TIMEOUT_SECS=90
# AIRNOTE_MEETING_LIVE_WHISPER_CPP_MODEL=~/Library/Application Support/VoicePolish/models/ggml-large-v3-turbo.bin
# AIRNOTE_MEETING_LIVE_WHISPER_LANGUAGE=en

# ── Meeting transcript cleanup ────────────────────────────────────────────────

# Provider for post-whisper meeting cleanup. Defaults to groq.
# Valid values: groq, gateway, deepseek
# AIRNOTE_MEETING_CLEANUP_PROVIDER=groq

# Override the cleanup model. Defaults:
#   groq     -> llama-3.3-70b-versatile
#   gateway  -> gemini-2.5-flash
#   deepseek -> deepseek-v4-pro
# AIRNOTE_MEETING_CLEANUP_MODEL=llama-3.3-70b-versatile

# Optional provider-specific override. If unset, groq uses GROQ_API_KEY,
# gateway uses GATEWAY_API_KEY, and deepseek uses DEEPSEEK_API_KEY.
# AIRNOTE_MEETING_CLEANUP_API_KEY=

# ── Meeting MoM + transcript chat ────────────────────────────────────────────

# Optional override for ended-meeting summary, action items, decisions, and chat.
# If unset, these reuse AIRNOTE_MEETING_CLEANUP_PROVIDER / MODEL / API key.
# AIRNOTE_MEETING_AI_PROVIDER=deepseek
# AIRNOTE_MEETING_AI_MODEL=deepseek-v4-pro
# AIRNOTE_MEETING_AI_API_KEY=
# AIRNOTE_MEETING_AI_TIMEOUT_SECS=120
# AIRNOTE_MEETING_AI_MAX_TOKENS=4096
# Default true: run a verifier pass and require transcript-backed evidence for
# action items and decisions. Set false only for latency/debug comparison.
# AIRNOTE_MEETING_AI_VERIFY=true

# ── Meeting final speaker diarization ────────────────────────────────────────

# Disabled by default in the optimized meeting flow. The default user-facing
# pipeline uses source labels only (You / Remote / System) because MoM quality is
# strong without heavy speaker diarization.
# AIRNOTE_MEETING_FINAL_DIARIZATION_ENABLED=false
#
# Optional second pass after local transcription finishes. Enable only when
# speaker identity is more important than speed/size. Live labels stay
# provisional; this command writes meeting.diarization.final.json and
# meeting.transcript.final.json after Leave Meeting. If the transcript contains
# both mic.wav and system.wav source tracks, the Sortformer helper diarizes each
# track separately and then merges the final timeline.
# AIRNOTE_MEETING_FINAL_DIARIZATION_ENABLED=true
#
# The script mode is easiest for local Sortformer testing:
# AIRNOTE_MEETING_FINAL_DIARIZATION_SCRIPT=tools/stt-bench/sortformer_diarize.py
# AIRNOTE_MEETING_FINAL_DIARIZATION_PYTHON=/tmp/airnote-nemo-venv/bin/python
#
# Or provide any executable that accepts:
# --audio <wav> --transcript-json <json> --diarization-out <json> --transcript-out <json>
# AIRNOTE_MEETING_FINAL_DIARIZATION_COMMAND=/path/to/final-diarizer
# AIRNOTE_MEETING_FINAL_DIARIZATION_PROVIDER=nemo_sortformer
# AIRNOTE_MEETING_FINAL_DIARIZATION_TIMEOUT_SECS=1800
#
# Sortformer helper options are read by tools/stt-bench/sortformer_diarize.py.
# AIRNOTE_NEMO_SORTFORMER_MODEL_PATH=/tmp/airnote-nemo-models/diar_streaming_sortformer_4spk-v2.1.nemo
# AIRNOTE_NEMO_MODEL_CACHE=~/Library/Application Support/VoicePolish/models/nemo
# AIRNOTE_FINAL_DIARIZATION_MAX_NEAREST_GAP_MS=750
# AIRNOTE_FINAL_ECHO_ACTIVITY_OVERLAP_RATIO=0.45
# AIRNOTE_FINAL_ECHO_SYSTEM_RMS_RATIO=4.0
# AIRNOTE_FINAL_ECHO_MAX_PAIR_GAP_MS=400
# AIRNOTE_FINAL_ECHO_TEXT_SIMILARITY_THRESHOLD=0.90
# AIRNOTE_FINAL_ECHO_TEXT_CONTAINMENT_THRESHOLD=0.60
# AIRNOTE_FINAL_ECHO_MIN_TOKEN_OVERLAP=3
# AIRNOTE_FINAL_ECHO_DRIFT_MARGIN_MS=1500
# Keep system audio as canonical text for remote echo by default. Set true only
# if mic capture is consistently cleaner than system capture in local tests.
# AIRNOTE_FINAL_ECHO_ALLOW_MIC_TEXT=false
# Drops unassigned ASR hallucinations that extend beyond the real audio length.
# AIRNOTE_FINAL_UNASSIGNED_OOB_MARGIN_MS=2000
# Drops unassigned tail hallucinations only when source activity says the track
# is silent. These are audio-evidence guards, not phrase-specific filters.
# AIRNOTE_FINAL_UNASSIGNED_SILENCE_TAIL_MARGIN_MS=2500
# AIRNOTE_FINAL_UNASSIGNED_SILENCE_MIN_COVERED_RATIO=0.90
# AIRNOTE_FINAL_UNASSIGNED_SILENCE_RATIO=0.80
# AIRNOTE_FINAL_UNASSIGNED_SILENCE_RMS_THRESHOLD=0.01

# ── Email (alias-review notifications, team invites) ─────────────────────────

# Resend transactional email. Optional; the app degrades gracefully if missing.
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Display name + verified sender. Defaults to "AirNote <onboarding@resend.dev>".
# RESEND_FROM=AirNote <hello@yourdomain.com>

# ── Backend ↔ Tauri shared secret ────────────────────────────────────────────

# Authenticates the desktop app's IPC calls to the local airnote-backend.
# Defaults to "dev-secret" — fine for development, must be changed for any
# build that ships to a user.
# POLISH_SHARED_SECRET=dev-secret

# ── Control-plane profile prompt (server runtime) ───────────────────────────

# Server-owned runtime profiles are first-class for voice polish.
# When an account/org profile exists, it is injected into the polish prompt.
# When no profile exists, no baked personal fallback is injected.

# DeepSeek model for profile learn-from-edit (default deepseek-v4-flash).
# DEEPSEEK_PROFILE_UPDATE_MODEL=deepseek-v4-flash

# Debug observability only: overwrite the last exact server-runtime polish prompt
# and user message to a local file. Does not change runtime behavior.
# AIRNOTE_RUNTIME_PROMPT_LOG=1
# AIRNOTE_RUNTIME_PROMPT_LOG_PATH=/tmp/airnote-runtime-prompt.log

# ── Legacy learning (debug only — not product config) ───────────────────────

# Production default: legacy vocab/alias/correction writes are FROZEN. Edit capture
# and audit (`edit_events`) continue. Polish still reads existing legacy rows.
#
# Set to 1 only for local regression of the OLD fragmented learning pipeline
# (eval-edit-learning, learning_flow_tests, etc.). Remove after profile updater ships.
# AIRNOTE_DEBUG_LEGACY_LEARNING_WRITES=1
