# AirNote — local development environment
#
# Copy this to `.env` at the repo root. The real `.env` is gitignored.
# Production installs do NOT use this file — end-users save their keys
# via `vp deepgram-key` and `vp auth` (Keychain + local SQLite).
#
# Most variables are optional with sensible fallbacks. The minimum to run
# the desktop app end-to-end against the cloud gateway is just one:
#   GATEWAY_API_KEY
# Self-hosted backend or direct-provider routing needs more.

# ── Cloud gateway (default routing) ──────────────────────────────────────────

# Required for cloud-gateway routing. Issued by the EMIAC ops team.
GATEWAY_API_KEY=

# Override the gateway base URL. Defaults to https://gateway.outreachdeal.com.
# Useful when running a local copy of the gateway.
# CLOUD_API_URL=http://localhost:8787

# ── Direct STT (Deepgram) ────────────────────────────────────────────────────

# Required if the backend is talking directly to Deepgram instead of going
# through the gateway. Get a key at https://console.deepgram.com/.
DEEPGRAM_API_KEY=

# ── Direct LLM providers (optional fallbacks) ────────────────────────────────

# Groq LPU — fastest TTFT, free tier. Used when llm_provider=groq in prefs.
# Get a key at https://console.groq.com/keys.
GROQ_API_KEY=

# Google Gemini Direct. Used when llm_provider=gemini_direct.
# Get a key at https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=

# OpenAI direct (only used as a last-resort fallback when every other
# provider fails — most setups go through ChatGPT OAuth instead).
OPENAI_API_KEY=

# ── Email (alias-review notifications, team invites) ─────────────────────────

# Resend transactional email. Optional; the app degrades gracefully if missing.
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Display name + verified sender. Defaults to "AirNote <onboarding@resend.dev>".
# RESEND_FROM=AirNote <hello@yourdomain.com>

# ── Backend ↔ Tauri shared secret ────────────────────────────────────────────

# Authenticates the desktop app's IPC calls to the local airnote-backend.
# Defaults to "dev-secret" — fine for development, must be changed for any
# build that ships to a user.
# POLISH_SHARED_SECRET=dev-secret
