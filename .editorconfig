root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 2

# Rust and TOML default to 4-space indent (rustfmt is the source of truth
# for .rs files; this matches it for editors that don't run rustfmt).
[*.{rs,toml}]
indent_size = 4

# Markdown: trailing spaces are syntactically meaningful (line break).
[*.md]
trim_trailing_whitespace = false

# Makefiles require literal tabs.
[Makefile]
indent_style = tab
