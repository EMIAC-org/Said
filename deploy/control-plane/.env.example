# Copy to .env on the deployment host. Do not commit the real .env.

# Image is written by CI during deploy, or set manually for local compose pulls.
CONTROL_PLANE_IMAGE=ghcr.io/OWNER/airnote-control-plane:latest

# Public/local bind. Keep 127.0.0.1 when using a reverse proxy on the same host.
CONTROL_PLANE_BIND=127.0.0.1
CONTROL_PLANE_PORT=3100

# Postgres container credentials. Keep the password URL-safe because compose
# interpolates it into DATABASE_URL.
POSTGRES_DB=said_control_plane
POSTGRES_USER=said
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_VOLUME_NAME=airnote-control-plane_postgres-data

# App secrets.
JWT_SECRET=replace-with-a-long-random-secret
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=https://airnote.emiactech.com/v1/auth/lark/callback
OPENAI_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# The public Codex client accepts the local CLI callback URI. The admin panel
# asks you to paste the callback URL/code after OpenAI redirects there.
OPENAI_REDIRECT_URI=http://localhost:1455/auth/callback

OPENAI_API_KEY=
GROQ_API_KEY=
GATEWAY_API_KEY=
# Server polish model — paid Gemma 4 31B via OpenRouter Nitro.
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Message polish (Option+1 / voice polish mode). Used by /v1/runtime/message-polish.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MESSAGE_POLISH_MODEL=deepseek-v4-flash
# Debug observability only: overwrite the last exact server-runtime polish prompt
# and user message to a local file. Does not change runtime behavior.
# AIRNOTE_RUNTIME_PROMPT_LOG=1
# AIRNOTE_RUNTIME_PROMPT_LOG_PATH=/tmp/airnote-runtime-prompt.log
# Required before saving BYOK provider credentials. Use a long random secret;
# the server derives an AES-256-GCM key from it and never stores plaintext keys.
RUNTIME_CREDENTIALS_KEY=replace-with-a-long-random-runtime-credential-secret

# Optional Caddy HTTPS reverse proxy:
# docker compose --profile caddy up -d
DOMAIN=airnote.emiactech.com
RELEASES_PATH=./releases

# ── Legacy personal memory (debug only — not product config) ─────────────────
#
# Production default: server personal_vocab / personal_stt_replacements /
# personal_edit_policy_rules writes are FROZEN. Learning events and history
# sync continue as audit/evidence. Runtime polish still reads existing rows.
#
# Set to 1 only for local regression of the OLD server personal-memory writers.
# AIRNOTE_DEBUG_LEGACY_PERSONAL_MEMORY_WRITES=1

RUST_LOG=info
