# Copy to .env on the deployment host. Do not commit the real .env.

# Image is written by CI during deploy, or set manually for local compose pulls.
CONTROL_PLANE_IMAGE=ghcr.io/OWNER/said-control-plane:latest

# Public/local bind. Keep 127.0.0.1 when using a reverse proxy on the same host.
CONTROL_PLANE_BIND=127.0.0.1
CONTROL_PLANE_PORT=3100

# Postgres container credentials. Keep the password URL-safe because compose
# interpolates it into DATABASE_URL.
POSTGRES_DB=said_control_plane
POSTGRES_USER=said
POSTGRES_PASSWORD=replace-with-a-long-random-password

# App secrets.
JWT_SECRET=replace-with-a-long-random-secret
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=https://your-domain.com/v1/auth/lark/callback
OPENAI_REDIRECT_URI=https://your-domain.com/openai/callback

# Optional Caddy HTTPS reverse proxy:
# docker compose --profile caddy up -d
DOMAIN=your-domain.com

RUST_LOG=info
