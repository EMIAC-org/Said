{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirNote",
  "mainBinaryName": "AirNote",
  "version": "2.3.6",
  "identifier": "com.emiac.airnote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AirNote",
        "width": 940,
        "height": 680,
        "minWidth": 780,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["underPageBackground"],
          "state": "followsWindowActiveState",
          "radius": 12.0
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/VoicePolish/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["airnote"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNDgwODVCODgzRjQ2RjcKUldUM1JqK0lXd2hJa3J0NDhrMlVRWnlnRFJDNlRUckhpNWVWQ1JCei9oKy95QjRHdjdGUXBaOVkK",
      "endpoints": [
        "https://airnote.emiactech.com/updates/{{target}}/latest.json",
        "https://github.com/EMIAC-org/Said/releases/latest/download/{{target}}-latest.json",
        "https://airnote.emiactech.com/updates/latest.json",
        "https://github.com/EMIAC-org/Said/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_256x256.png",
      "icons/icon_512x512.png"
    ],
    "externalBin": [
      "binaries/airnote-backend"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "Developer ID Application: EMIAC TECHNOLOGIES LIMITED (96ZQGP7L3B)"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
