{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Said",
  "mainBinaryName": "Said",
  "version": "2.2.0-beta15",
  "identifier": "com.emiac.said.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Said",
        "width": 1240,
        "height": 880,
        "minWidth": 980,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNDgwODVCODgzRjQ2RjcKUldUM1JqK0lXd2hJa3J0NDhrMlVRWnlnRFJDNlRUckhpNWVWQ1JCei9oKy95QjRHdjdGUXBaOVkK",
      "endpoints": [
        "https://github.com/EMIAC-org/Said/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_256x256.png",
      "icons/icon_512x512.png"
    ],
    "externalBin": [
      "binaries/said-backend"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
