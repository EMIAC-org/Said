# Desktop (Vite) build-time configuration.
# Copy to `.env` and adjust for local development. Only VITE_-prefixed vars are
# exposed to the app (via import.meta.env).

# Control-plane / workspace server the desktop app talks to by default.
# - Used as the default workspace/sign-in URL in onboarding and the personal
#   email sign-in target (src/lib/enterprise.ts → DEFAULT_CLOUD_SERVER_URL).
# - Overridable at runtime via Settings → Workspace server.
# - If unset, falls back to the built-in dev default below.
VITE_AIRNOTE_SERVER_URL=https://airnote-dev.103.180.163.41.sslip.io
