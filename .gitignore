# Tauri sidecar binaries — generated by `cargo build -p said-backend` and
# copied into desktop/src-tauri/binaries/ at bundle/run time. Don't commit;
# they're large (200MB+ for the unstripped Windows debug build) and rebuilt
# per host in CI.
desktop/src-tauri/binaries/said-backend-*-windows-*.exe
desktop/src-tauri/binaries/said-backend-*-windows-*
desktop/src-tauri/binaries/said-backend-x86_64-*
!desktop/src-tauri/binaries/said-backend-aarch64-apple-darwin

