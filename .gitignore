# Secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Rust
/target
**/target/

# Large local trees — keep out of git add / Conductor checkpoints (multi-GB)
/voicetypr/
/lab/whisper_hinglish_eval/
/lab/.venv-nemotron/
/lab/**/*.bin
/lab/**/hf-cache/
/lab/**/.hf-cache/
**/ggml-*.bin
**/*.ggml

# Generated Tauri sidecars
desktop/src-tauri/binaries/airnote-backend-*
desktop/src-tauri/binaries/whisper-cli-*

# Node / frontend dependencies
desktop/node_modules/
**/node_modules/

# Frontend build output
desktop/dist/

# TypeScript incremental build cache
**/tsconfig.tsbuildinfo

# Python (legacy)
venv/
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Mobile generated/build artifacts
mobile/ios/*.xcodeproj/
mobile/ios/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/

# Temp audio
*.wav

# Claude Code worktrees & local config
.claude/
.context/

# Eval pipeline downloaded data (regenerate with download_transcripts.py)
tools/eval-pipeline/transcripts.jsonl

# Whisper model files (large binary, downloaded separately)
models/*.bin

# Local STT benchmark HF weights (ephemeral; purged after compare)
tools/stt-compare/.hf-cache/
tools/stt-compare/.last_compare.json
tools/stt-compare/.local_stt_benchmark.json

# Reference repo (read-only design reference; not part of the build)
/boring.notch/
/reference-voicetypr/
/reference-handy/
/reference-freeflow/
/reference-voiceink/
/reference-glimpse/
/reference-openwhispr/

# Native notch HUD sidecar (Swift) — build output + staged sidecar binary
desktop/notch-sidecar/.build/
desktop/src-tauri/binaries/airnote-notch-*

# Windows GPU dictation worker sidecar binary (built by scripts/build-windows.ps1 -RebuildWorker)
desktop/src-tauri/binaries/airnote-asr-gpu-*
# Local build/run logs
/*.log
/desktop/*.log
crates/asr-gpu-worker/*.log
